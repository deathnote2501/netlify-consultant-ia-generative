# Project Settings
PROJECT_NAME="Formation IA Backend"
API_V1_STR="/api/v1"

# Database (PostgreSQL Async)
# Example: DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/formation_db"
DATABASE_URL="postgresql+asyncpg://your_db_user:your_db_password@your_db_host:your_db_port/your_db_name"

# JWT Settings
JWT_SECRET="!!CHANGE_THIS_IN_PRODUCTION_TO_A_VERY_STRONG_RANDOM_STRING!!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60 # Example: 1 hour

# Google Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Brevo (Sendinblue) API Key
BREVO_API_KEY="YOUR_BREVO_API_KEY_HERE"

# Stripe Settings
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_TEST_SECRET_KEY" # Use test key for development
STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_TEST_PUBLISHABLE_KEY" # Use test key for development
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_TEST_WEBHOOK_SECRET" # Use test key for development

# Frontend URL (for CORS and email links)
FRONTEND_URL="http://localhost:5173" # Default for SvelteKit dev server

# Note: For production, ensure these variables are set securely in your environment.
